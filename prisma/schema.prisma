generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ProjectType {
  INTERIOR
  BRANDING
  SOCIAL
  WEB
}

enum ProjectStatus {
  BRIEF
  CONCEPT
  DRAFT
  REVISION
  FINAL
  DELIVERED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum ReminderStatus {
  UPCOMING
  DUE_TODAY
  OVERDUE
  DONE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadsAssigned      Lead[]            @relation("LeadAssignee")
  clientsCreated     Client[]
  quotationsCreated  Quotation[]
  projectsCreated    Project[]
  projectAssignments ProjectAssignee[]
  tasksAssigned      Task[]
  filesUploaded      ProjectFile[]
  ledgerEntries      LedgerEntry[]
  reminders          Reminder[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  notes       String?  @db.Text
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  leads         Lead[]
  quotations    Quotation[]
  projects      Project[]
  ledgerEntries LedgerEntry[]
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  phone        String?
  email        String?
  service      String
  budget       Decimal?   @db.Decimal(12, 2)
  followUpDate DateTime?
  status       LeadStatus @default(NEW)
  client       Client?    @relation(fields: [clientId], references: [id])
  clientId     String?
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  createdAt    DateTime   @default(now())
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  client          Client          @relation(fields: [clientId], references: [id])
  clientId        String
  status          QuotationStatus @default(DRAFT)
  reference       String?
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  terms           String?         @db.Text
  createdBy       User            @relation(fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime        @default(now())

  items    QuotationItem[]
  projects Project[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
  description String
  quantity    Int       @default(1)
  rate        Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2)
}

model Project {
  id           String        @id @default(cuid())
  client       Client        @relation(fields: [clientId], references: [id])
  clientId     String
  quotation    Quotation?    @relation(fields: [quotationId], references: [id])
  quotationId  String?
  title        String
  type         ProjectType
  status       ProjectStatus @default(BRIEF)
  projectValue Decimal?      @db.Decimal(12, 2)
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdById  String
  startDate    DateTime?
  deadline     DateTime?
  createdAt    DateTime      @default(now())

  assignees     ProjectAssignee[]
  tasks         Task[]
  files         ProjectFile[]
  approvals     ClientApproval[]
  revisions     Revision[]
  ledgerEntries LedgerEntry[]
}

model ProjectAssignee {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  assignedAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Task {
  id              String     @id @default(cuid())
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  title           String
  description     String?    @db.Text
  assignedTo      User?      @relation(fields: [assignedToId], references: [id])
  assignedToId    String?
  priority        Priority   @default(MEDIUM)
  status          TaskStatus @default(TODO)
  progressPercent Int        @default(0)
  dueDate         DateTime?
  createdAt       DateTime   @default(now())
}

model ProjectFile {
  id             String         @id @default(cuid())
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
  uploadedById   String
  fileUrl        String
  fileType       String?
  version        Int            @default(1)
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  approvals ClientApproval[]
}

model ClientApproval {
  id         String         @id @default(cuid())
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  file       ProjectFile?   @relation(fields: [fileId], references: [id])
  fileId     String?
  itemType   String
  status     ApprovalStatus @default(PENDING)
  reviewedAt DateTime?
  notes      String?        @db.Text
}

model Revision {
  id             String   @id @default(cuid())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  itemType       String
  revisionNumber Int      @default(1)
  revisionLimit  Int      @default(3)
  createdAt      DateTime @default(now())
}

model LedgerEntry {
  id           String          @id @default(cuid())
  client       Client          @relation(fields: [clientId], references: [id])
  clientId     String
  project      Project?        @relation(fields: [projectId], references: [id])
  projectId    String?
  entryType    LedgerEntryType
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  entryDate    DateTime        @default(now())
  recordedBy   User            @relation(fields: [recordedById], references: [id])
  recordedById String
}

model Reminder {
  id                String         @id @default(cuid())
  type              String
  relatedEntityType String?
  relatedEntityId   String?
  dueDate           DateTime
  status            ReminderStatus @default(UPCOMING)
  assignedTo        User           @relation(fields: [assignedToId], references: [id])
  assignedToId      String
  createdAt         DateTime       @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model Notification {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  message           String
  isRead            Boolean  @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())
}
